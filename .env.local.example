# `npm run dev` loads the Firebase values from managed secrets. Copy this file
# only when intentionally running `npm run dev:plain` with explicit local values.
NEXT_PUBLIC_FIREBASE_API_KEY=
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=
NEXT_PUBLIC_FIREBASE_PROJECT_ID=
NEXT_PUBLIC_FIREBASE_STORAGE_BUCKET=
NEXT_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=
NEXT_PUBLIC_FIREBASE_APP_ID=
NEXT_PUBLIC_FIREBASE_MEASUREMENT_ID=

# Optional. Analytics is disabled cleanly when this is unset.
NEXT_PUBLIC_GA_ID=

# Local xtara-web should talk to the separately running xtara-api service.
NEXT_PUBLIC_XTARA_API_BASE_URL=http://127.0.0.1:3111

# Optional same-origin proxy for browser environments that block direct access
# to a separate localhost API port. When enabled, set the public base URL to the
# web proxy path (for example /xtara-service).
# XTARA_API_PROXY_TARGET=http://127.0.0.1:3111

# Production defaults to the same-origin /xtara-service proxy. Set both values
# only for preview/staging environments that use a different API deployment.
# NEXT_PUBLIC_XTARA_API_BASE_URL=/xtara-service
# XTARA_API_PROXY_TARGET=https://your-api-service.run.app
